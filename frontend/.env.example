# Backend API Base URL (Spring Boot)
# Local development default: http://localhost:8080
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:8080

# Backend WebSocket URL (Optional: automatically derived from VITE_API_BASE_URL if omitted)
# Local development default: ws://localhost:8080/ws/workflow
# Production: wss://your-backend-domain.com/ws/workflow
VITE_WS_BASE_URL=ws://localhost:8080/ws/workflow
