server.port=${PORT:8080}

# Database configuration (Neon DB or local PostgreSQL)
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/proposals_db}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:your_password_here}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# FastAPI AI Microservice endpoints
fastapi.plan-url=${FASTAPI_PLAN_URL:http://127.0.0.1:8000/plan}
fastapi.research-url=${FASTAPI_RESEARCH_URL:http://127.0.0.1:8000/research}
fastapi.execute-pricing-url=${FASTAPI_EXECUTE_PRICING_URL:http://127.0.0.1:8000/execute/pricing}
fastapi.execute-draft-url=${FASTAPI_EXECUTE_DRAFT_URL:http://127.0.0.1:8000/execute/draft}
fastapi.reflect-review-url=${FASTAPI_REFLECT_REVIEW_URL:http://127.0.0.1:8000/reflect/review}
fastapi.execute-revise-url=${FASTAPI_EXECUTE_REVISE_URL:http://127.0.0.1:8000/execute/revise}
workflow.reflector.max-retries=3

# 256-bit HMAC-SHA Secret for JWT Signing
jwt.secret=${JWT_SECRET:CHANGE_ME_TO_A_SECURE_256_BIT_SECRET_KEY}
